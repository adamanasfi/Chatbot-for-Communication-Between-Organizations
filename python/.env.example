OPENAI_API_KEY="sk-"

# Optional for LangSmith tracing and experiment tracking
LANGSMITH_API_KEY="lsv2"
LANGSMITH_ENDPOINT="https://api.smith.langchain.com" #defaults to https://api.smith.langchain.com if using cloud
LANGSMITH_TRACING="true"
LANGSMITH_PROJECT="agent2agent"

# agent2agent
AGENT_A_ID=""
AGENT_B_ID=""

# Optional: enables reverse-geocoding (address instead of raw lat/lng) in
# Red Cross's share_vehicle_location tool, and the Vehicles map in its
# console. Without it, the tool still works and shares a plain Google
# Maps link, and the map shows a "not configured" notice instead.
GOOGLE_MAPS_API_KEY=""

# Optional: Civil Defense's own, separate key for its read-only vehicle
# tracking map -- kept distinct from Red Cross's key (different org,
# different origin, so a leak of one doesn't expose the other).
CIVILDEFENSE_GOOGLE_MAPS_API_KEY=""